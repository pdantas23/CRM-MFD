# =============================================================================
# CRM-MFD — Exemplo de configuração de ambiente (multi-conta VHSYS)
# Copie para `.env.local` e preencha. NUNCA commite o `.env.local` real.
# Este arquivo é o guia de onboarding para qualquer nova empresa.
# =============================================================================

# -----------------------------------------------------------------------------
# BOOTSTRAP — valores únicos da aplicação (não variam por conta VHSYS)
# -----------------------------------------------------------------------------

# URL do projeto Supabase (público; vai para o browser).
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima do Supabase (público; respeita RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave service role do Supabase (SECRETA; bypassa RLS — só no servidor).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Segredo do cron de sincronização. A Vercel envia "Authorization: Bearer <CRON_SECRET>".
# Gere um valor aleatório forte (ex.: `openssl rand -hex 32`).
CRON_SECRET=troque-por-um-segredo-aleatorio-forte

# Chave-mestra para cifrar as credenciais VHSYS gravadas na tabela `accounts`
# (AES-256-GCM). 32 bytes em base64. Gere com `openssl rand -base64 32`.
# SECRETA — nunca exponha; sua perda inutiliza as credenciais cifradas.
APP_MASTER_KEY=troque-por-uma-chave-de-32-bytes-base64

# Nome da aplicação (server-side): rótulo da aba e fallback antes de selecionar
# a conta. Após selecionar, o nome real vem do VHSYS (accounts.nome_empresa).
APP_NAME=CRM

# Nome exibido na tela de LOGIN (client-side, antes de haver conta ativa).
NEXT_PUBLIC_APP_NAME=CRM

# Subtítulo opcional da tela de login (client-side).
NEXT_PUBLIC_APP_LOGIN_SUBTITLE=Acesso interno

# User-Agent enviado à API VHSYS. Genérico — não embuta o nome de uma empresa.
APP_USER_AGENT=CRM/0.1

# -----------------------------------------------------------------------------
# SEED POR CONTA — lido UMA vez por `scripts/seed-accounts.ts` e gravado
# (cifrado) na tabela `accounts`. Replique o bloco para cada conta VHSYS.
# Caso de uso principal: uma empresa com 2 contas VHSYS (2 CNPJs/filiais).
# -----------------------------------------------------------------------------

# --- Conta 1 -----------------------------------------------------------------
# Identificador curto da conta (usado no seletor, cookie e URL). Ex.: matriz, filial-sul.
VHSYS_ACCOUNT_1_SLUG=matriz
# Token de acesso da API VHSYS desta conta (SECRETO).
VHSYS_ACCOUNT_1_ACCESS_TOKEN=access-token-da-conta-1
# Secret token da API VHSYS desta conta (SECRETO).
VHSYS_ACCOUNT_1_SECRET_ACCESS_TOKEN=secret-token-da-conta-1
# Base da API VHSYS (opcional; default abaixo serve para a maioria).
VHSYS_ACCOUNT_1_API_BASE=https://api.vhsys.com/v2
# Cor primária do tema para esta conta (hex). Usada na navbar, botões e sidebar.
# Facilita a diferenciação visual entre contas.
VHSYS_ACCOUNT_1_THEME_COLOR=#1a73e8

# --- Conta 2 -----------------------------------------------------------------
VHSYS_ACCOUNT_2_SLUG=filial-sul
VHSYS_ACCOUNT_2_ACCESS_TOKEN=access-token-da-conta-2
VHSYS_ACCOUNT_2_SECRET_ACCESS_TOKEN=secret-token-da-conta-2
VHSYS_ACCOUNT_2_API_BASE=https://api.vhsys.com/v2
# Cor distinta da conta 1 para diferenciação visual imediata.
VHSYS_ACCOUNT_2_THEME_COLOR=#d93025

# -----------------------------------------------------------------------------
# SERVIÇOS EXTERNOS (opcional) — públicos; defaults embutidos já funcionam.
# -----------------------------------------------------------------------------

# Base da API de CEP (default: ViaCEP).
# CEP_API_BASE=https://viacep.com.br/ws/

# Base da API de consulta de CNPJ (default: BrasilAPI).
# CNPJ_API_BASE=https://brasilapi.com.br/api/cnpj/v1/
